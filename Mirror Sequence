public class Solution{
     public boolean isMirrorSequence(int[] arr) {
      int left=0,right=arr.length-1;
      int mid=arr.length/2;
      if(arr.length==0 || arr.length%2!=0)
      return false;
    while(left<right){

    
         if (arr[left] != arr[right]) {
                return false;
            }
            left++;
            right--;}
          return true;
      
     }
}
